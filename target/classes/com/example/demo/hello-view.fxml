<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.HelloController">

    <Label text="Data is automatically saved upon exit and loaded upon start"/>
    <Button text="Refresh contents" onAction="#initialize"/>
    <ToggleButton text="Sort ascendingly" fx:id="asc"/>
    <HBox>
        <VBox>
            <HBox>
                <Label text="Customers"/>
                <VBox>
                    <TextField promptText="ID" fx:id="cI"/>
                    <TextField promptText="Name" fx:id="cN"/>
                    <TextField promptText="Address" fx:id="cA"/>
                    <TextField promptText="Phone number" fx:id="cP"/>
                </VBox>
                <ButtonBar>
                    <buttons>
                        <Button text="Add/Update from ID" onAction="#cAU"/>
                        <Button text="Search by name" onAction="#cSN"/>
                        <Button text="Search by Phone number" onAction="#cSP"/>
                    </buttons>
                </ButtonBar>
            </HBox>
            <HBox>
                <Label text="Deliverymen"/>
                <VBox>
                    <TextField promptText="ID" fx:id="dI"/>
                    <TextField promptText="Name" fx:id="dN"/>
                    <TextField promptText="Phone number" fx:id="dP"/>
                </VBox>
                <ButtonBar>
                    <buttons>
                        <Button text="Add/Update from ID" onAction="#dAU"/>
                        <Button text="Delete from ID" onAction="#delD"/>
                        <Button text="Search by name" onAction="#dSN"/>
                        <Button text="Search by Phone number" onAction="#dSP"/>
                    </buttons>
                </ButtonBar>
            </HBox>
            <HBox>
                <Label text="Items"/>
                <VBox>
                    <TextField promptText="ID" fx:id="iI"/>
                    <TextField promptText="Name" fx:id="iN"/>
                    <TextField promptText="price" fx:id="iP"/>
                </VBox>
                <ButtonBar>
                    <buttons>
                        <Button text="Add/Update from ID" onAction="#iAU"/>
                        <Button text="Delete from ID" onAction="#delI"/>
                        <Button text="Search by name" onAction="#iSN"/>
                        <Button text="Search by price" onAction="#iSP"/>
                    </buttons>
                </ButtonBar>
            </HBox>
            <HBox>
                <Label text="Orders"/>
                <VBox>
                    <TextField promptText="ID" fx:id="oI"/>
                    <DatePicker promptText="Select date" fx:id="oD"/>
                    <ComboBox promptText="Choose customer" fx:id="cL"/>
                    <ListView fx:id="iL"/>
                    <ComboBox promptText="Choose deliveryman" fx:id="dL"/>
                </VBox>
                <ButtonBar>
                    <buttons>
                        <Button text="Add/Update from ID" onAction="#oAU"/>
                        <Button text="Delete from ID" onAction="#delO"/>
                        <Button text="Search by ID" onAction="#oSI"/>
                        <Button text="Search by Date of creation" onAction="#oSD"/>
                    </buttons>
                </ButtonBar>
            </HBox>
        </VBox>
        <VBox>
            <Label text="Results:"/>
            <TextArea fx:id="res"/>
        </VBox>
    </HBox>
</VBox>
